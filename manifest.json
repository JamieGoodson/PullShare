{
  "manifest_version": 3,
  "name": "PullShare",
  "version": "1.0.0",
  "description": "One click turns any GitHub PR into a clean, share-ready link.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
